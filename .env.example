# Copy to .env for `npm run dev`. On Render, set these in the dashboard (see render.yaml).
PORT=4100

# The one owner this demo answers for (users.id in the ERP database)
OWNER_ID=

# ERP database (UAT) — read-only access is enough; the app also forces read-only transactions
DATABASE_URL=postgres://user:password@host:5432/erp_db
DATABASE_SSL=false

# ERP API gateway — settlements come from the same endpoint as the Owner Financials tab
ERP_API_URL=https://your-uat-domain/api
ERP_API_EMAIL=
ERP_API_PASSWORD=

# Gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Zephyr

